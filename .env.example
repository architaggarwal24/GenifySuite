# --- Database -----------------------------------------------------------
# Using Supabase: get both of these from Project Settings -> Database ->
# Connection string. DATABASE_URL is the pooled ("Transaction" mode, port
# 6543) connection Prisma uses at runtime; DIRECT_URL is the direct (port
# 5432) connection Prisma needs for `db push` / `migrate`. Other Postgres
# providers (Neon, Vercel Postgres, local) can point both at the same URL.
DATABASE_URL="postgresql://postgres.xxxxxxxx:[password]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxx:[password]@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Auth.js (NextAuth) ---------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
# Your site's public address. Besides NextAuth, this is what the links in verification and password-reset
# emails are built from, so in production it MUST be your real https:// URL (never taken from the request).
NEXTAUTH_URL="http://localhost:3000"

# --- Email (verification + password reset) ------------------------------------
# Sent through Resend (https://resend.com, free tier is plenty). Verify a sending domain there, create an
# API key, and fill in both lines. EMAIL_FROM must use that domain, e.g. "GenifySuite <hello@yourdomain.com>".
# With no key set: in development the email (and its link) is printed to your terminal so everything works
# locally; in production nothing is sent and an error is logged.
RESEND_API_KEY=""
EMAIL_FROM=""

# --- OAuth providers (optional but recommended) ---------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub -> Settings -> Developer settings -> OAuth Apps
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Mirror of whether the two vars above are set, so the sign-in page only
# shows buttons for providers you've actually configured. Set to "true"
# once you've filled in the matching client id/secret above.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED="false"
NEXT_PUBLIC_GITHUB_OAUTH_ENABLED="false"

# --- IP Finder tool --------------------------------------------------------
# Free tier, no key required, used server-side: https://ip-api.com
# If you swap providers, update src/app/api/ip-lookup/route.ts

# --- AI features -----------------------------------------------------------
# Encrypts BYOK API keys before they're stored. Generate with:
# openssl rand -base64 32
ENCRYPTION_KEY=""

# Optional: GenifySuite's own Anthropic key, used only when a signed-in user
# picks "use GenifySuite's key" instead of bringing their own. Leave blank
# to disable that option entirely (BYOK still works fine without it).
ANTHROPIC_API_KEY=""
# Model used for the shared-key path specifically (kept cheap by default
# since you're paying for it - BYOK users pick their own model per key).
GENIFY_SHARED_MODEL="claude-haiku-4-5"

# --- Billing (Stripe) — only needed if you enable the "use our key" plans --
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""

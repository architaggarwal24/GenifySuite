{
  "name": "genifysuite",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy --warm-cache",
    "deploy:response-store": "cf deploy --prebuilt --mode production --worker genifysuite-response-store"
  },
  "dependencies": {
    "@cloudflare/workers-response-store": "^1.0.1",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.20.0",
    "@vinext/cloudflare": "^1.0.1",
    "bcryptjs": "^2.4.3",
    "cmdk": "^1.0.4",
    "lucide-react": "^0.462.0",
    "next": "16.3.7",
    "next-auth": "^4.24.15",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^9.0.1",
    "react-server-dom-webpack": "^19.3.0",
    "stripe": "^17.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.sha-52b0dc0e9",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.36",
    "autoprefixer": "^10.4.20",
    "cf": "^1.0.0-beta.13",
    "postcss": "^8.4.45",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vinext": "^1.0.1",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "workerd@1.20261012.1": true
  },
  "type": "module"
}

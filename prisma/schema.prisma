generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Auth.js models (Prisma adapter schema) --------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // null when the account only uses OAuth
  // Sessions issued before this moment are no longer valid. Set on password change/reset and on
  // "sign out everywhere"; checked on every session read (see src/lib/session-validity.ts).
  sessionsValidAfter DateTime?
  createdAt     DateTime  @default(now())

  accounts     Account[]
  sessions     Session[]
  historyItems HistoryItem[]
  apiKeys      ApiKey[]
  subscription Subscription?
  aiUsage      AiUsage[]
  workflows    Workflow[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App data ---------------------------------------------------------------

// One row per "save to history" action from any tool. `tool` identifies which
// tool produced it, `label` is a short human-readable summary shown in the
// dashboard list, and `payload` holds the tool-specific JSON data so we don't
// need a separate table per tool.
model HistoryItem {
  id        String   @id @default(cuid())
  userId    String
  tool      String
  label     String
  payload   Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tool])
  @@index([userId, createdAt])
}

// --- AI: BYOK, agent, and billing -------------------------------------------

enum AiProvider {
  ANTHROPIC
  OPENAI
  OLLAMA
  NIM
  CUSTOM
}

// A user-supplied ("bring your own key") credential for one AI provider.
// `secret` is encrypted at rest (see src/lib/crypto.ts) — never stored or
// returned to the client in plaintext. `baseUrl` is required for
// self-hosted/OpenAI-compatible providers (Ollama, NIM, Custom) and optional
// elsewhere (lets someone point "openai" at an Azure/proxy endpoint, etc).
model ApiKey {
  id           String     @id @default(cuid())
  userId       String
  provider     AiProvider
  label        String
  baseUrl      String?
  secret       String? // encrypted ciphertext; null for keyless local endpoints
  defaultModel String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, label])
}

enum SubscriptionTier {
  FREE
  STARTER
  PRO
}

// Tracks a user's subscription for using GenifySuite's own shared AI keys
// (the "I don't have a key, use yours" path). Absence of a row, or tier
// FREE, means they only get the small daily trial allowance defined in
// src/lib/ai/usage.ts.
model Subscription {
  id                   String           @id @default(cuid())
  userId               String           @unique
  tier                 SubscriptionTier @default(FREE)
  stripeCustomerId     String?          @unique
  stripeSubscriptionId String?          @unique
  status               String? // Stripe subscription status: active, past_due, canceled, ...
  currentPeriodEnd     DateTime?
  updatedAt            DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One row per user, per UTC day, per source, counting AI requests. "shared" is usage of GenifySuite's
// own key (capped by subscription tier); "byok" is usage of the user's own key (a flat abuse guard).
// They're separate counters so working through your own key never burns your shared-key allowance.
model AiUsage {
  id     String @id @default(cuid())
  userId String
  date   String // "YYYY-MM-DD", UTC
  source String @default("byok") // "shared" | "byok"
  count  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, source])
}

// A saved agent prompt the user can re-run in one click from the AI agent page.
model Workflow {
  id        String   @id @default(cuid())
  userId    String
  name      String
  prompt    String   @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Fixed-window request counters used to rate limit AI endpoints per user per minute.
// `key` embeds scope, user and window ("ai-byok:<userId>:<windowIndex>"), so an atomic
// upsert-increment on a single unique column is all the limiter needs. Old rows are
// pruned opportunistically (see src/lib/rate-limit.ts).
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime

  @@index([windowStart])
}
